# API Server 配置
# 默认只监听本机；仅在受控网络或反向代理之后才改为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8090

# Bearer Token 认证（逗号分隔支持多 Token）
# 默认 fail-closed：API_TOKENS 为空且 AUTH_DISABLED!=1 时，受保护端点返回 503
API_TOKENS=
# 仅本地开发可显式设为 1；生产环境保持 0 并配置 API_TOKENS
AUTH_DISABLED=0

# 请求限流（滑动窗口，每分钟最大请求数）
RATE_LIMIT_ENABLED=1
RATE_LIMIT_RPM=30
# 默认不信任 X-Forwarded-For，防止客户端伪造来源 IP 绕过限流
# 仅当 API 只接受可信反向代理的流量时才设为 1
TRUST_PROXY=0

# API 与 Worker 共享的 Valkey 结果缓存；0 表示永久保留
RESULT_CACHE_TTL_SECONDS=3600

# Worker 重试（最大次数包含首次执行）
ARQ_WORKER_MAX_TRIES=5
ARQ_RETRY_DEFER_SECONDS=5

# Agent 配置目录（默认自动检测）
# AGENT_CONF_DIR=/path/to/conf

# Agent 和 LLM 配置名
AGENT_CONFIG=mirothinker_v1.5_keep5_max200
LLM_CONFIG=qwen-3

# 日志目录
LOG_DIR=logs/api-server

# LLM 网关（继承自 miroflow-agent 的配置）
BASE_URL=https://api.longcat.chat/openai
API_KEY=your_api_key
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=your_default_model
MODEL_TOOL_NAME=your_tool_model
MODEL_FAST_NAME=your_fast_model
MODEL_THINKING_NAME=your_thinking_model
MODEL_SUMMARY_NAME=your_summary_model
MODEL_FALLBACK_NAME=
